[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/training_hud.gd" id="1_hud"]

[node name="TrainingHUD" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_hud")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 18

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
mouse_filter = 2

[node name="TopBar" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
mouse_filter = 2

[node name="ExerciseTitle" type="Label" parent="MarginContainer/VBoxContainer/TopBar"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Spike Training (M1.2)"

[node name="DifficultyLabel" type="Label" parent="MarginContainer/VBoxContainer/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.8, 0.2, 1)
theme_override_font_sizes/font_size = 18
text = "[Beginner]"

[node name="PhaseLabel" type="Label" parent="MarginContainer/VBoxContainer/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "Phase: IDLE"
horizontal_alignment = 1

[node name="StatsContainer" type="HBoxContainer" parent="MarginContainer/VBoxContainer/TopBar"]
layout_mode = 2
mouse_filter = 2

[node name="StatsLabel" type="Label" parent="MarginContainer/VBoxContainer/TopBar/StatsContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Feeds: 0 | Done: 0 | Hits: 0 (C: 0, W: 0) | Miss: 0 | Untouched: 0 | In: 0 | Out: 0"

[node name="ReadinessContainer" type="CenterContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
mouse_filter = 2

[node name="ReadinessPanel" type="PanelContainer" parent="MarginContainer/VBoxContainer/ReadinessContainer"]
visible = false
layout_mode = 2
mouse_filter = 2

[node name="ReadinessLabel" type="Label" parent="MarginContainer/VBoxContainer/ReadinessContainer/ReadinessPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.1, 1, 0.3, 1)
theme_override_font_sizes/font_size = 22
text = ">>> IN HITTING WINDOW - SPIKE NOW! <<<"
horizontal_alignment = 1

[node name="CenterFeedback" type="CenterContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="FeedbackPanel" type="PanelContainer" parent="MarginContainer/VBoxContainer/CenterFeedback"]
visible = false
layout_mode = 2
mouse_filter = 2

[node name="FeedbackLabel" type="Label" parent="MarginContainer/VBoxContainer/CenterFeedback/FeedbackPanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Clean Spike!"
horizontal_alignment = 1

[node name="BottomBar" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
mouse_filter = 2

[node name="ControlsHint" type="Label" parent="MarginContainer/VBoxContainer/BottomBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 14
text = "[WASD] Move   [Space] Jump   [LMB] Spike Attack   [Mouse] Aim/Camera   [F] Request Feed   [R] Reset Ball   [Esc] Toggle Mouse"
